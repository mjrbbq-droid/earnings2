# --- Secrets ---
.env
.env.*
*.key
*.pem

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/
.virtual_documents/
Untitled*.ipynb

# --- IDE / tooling ---
.claude/
.idea/
*.swp
.DS_Store

# (Keep .vscode/ tracked so workspace settings travel with the project,
#  but ignore per-user noise inside it.)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# --- Data: bulk source data (gitignored - re-downloadable) ---
data/raw_sources/
data/processed/

# --- Data: live databases (regeneratable from parsers) ---
data/databases/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqbpro

# --- Data: deliverables (regenerated by export scripts) ---
data/outputs/

# --- Data: REVIEW_LATER (things to triage; not for tracking) ---
data/REVIEW_LATER/

# --- Local screenshot/extract scratch ---
data/_doc*_extract/

# --- Data: legacy / catch-all (in case things are at root before reorg) ---
data/*.xlsx
data/*.xlsm
data/*_zscores.csv
data/processed_articles/

# --- Logs ---
logs/
*.log
