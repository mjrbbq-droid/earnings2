; EditorConfig - works in Visual Studio, VS Code, JetBrains, vim, etc.
; https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
end_of_line = crlf

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
